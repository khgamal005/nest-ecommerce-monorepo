{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2021", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ecommerce/ui": ["libs/shared/ui/src/index.ts"],
      "@ecommerce/types": ["libs/shared/types/src/index.ts"],
      "@ecommerce/utils": ["libs/shared/utils/src/index.ts"],
      "@ecommerce/api-client": ["libs/shared/api-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
